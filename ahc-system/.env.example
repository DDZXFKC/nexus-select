# ===== Database =====
# Use SQLite by default. For Postgres/MySQL/Supabase, set the full URL.
# Examples:
#   postgresql+psycopg2://user:pass@host:5432/ahc
#   mysql+pymysql://user:pass@host:3306/ahc
#   sqlite:///./data/ahc.db   (default)
AHC_DB_URL=sqlite:///./data/ahc.db

# If the existing collection system uses its own DB, point this at it
# (read-only access is enough for lookups).
AHC_EXISTING_DB_URL=

# ===== Email (order intake) =====
# IMAP server for the inbox that receives BUYMA / After Hours Club orders.
AHC_IMAP_HOST=
AHC_IMAP_PORT=993
AHC_IMAP_USER=
AHC_IMAP_PASSWORD=
AHC_IMAP_SSL=true
# Only parse mail from these senders (comma-separated, lowercase substrings).
AHC_ORDER_SENDERS=buyma.com,afterhoursclub

# ===== Playwright =====
# Headless by default. Set false while developing cart flows.
AHC_PLAYWRIGHT_HEADLESS=true
# Hard upper bound for any single cart total (currency = store currency).
AHC_MAX_CART_AMOUNT=300000
# Hard floor on per-order profit (in JPY). Below this, never proceed.
AHC_MIN_PROFIT_JPY=0
# If true, the system will prepare carts and stop BEFORE any payment.
AHC_DRY_RUN_ONLY=true

# ===== Network politeness =====
AHC_REQUEST_TIMEOUT=20
AHC_REQUEST_RATE_LIMIT_RPS=1.0
AHC_USER_AGENT=Mozilla/5.0 (compatible; AHC-compliance-bot/0.1)

# ===== Logging =====
AHC_LOG_LEVEL=INFO
AHC_LOG_FILE=./data/ahc.log

# ===== Store / coupon config files =====
AHC_STORES_CONFIG=./config/stores.yaml
AHC_COUPON_SOURCES_CONFIG=./config/coupon_sources.yaml
AHC_COMPLIANCE_CONFIG=./config/compliance.yaml
