{
  "base_url": "http://kaitsuke-shop.local/",
  "export_json": "~/ahc-qa-reports/export/latest.json",
  "report_dir": "~/ahc-qa-reports",
  "allowed_hosts": ["kaitsuke-shop.local"],
  "purchase_allowed_hosts": ["kaitsuke-shop.local"],
  "crawl": {
    "max_pages": 3000,
    "delay_seconds": 0.2,
    "timeout_seconds": 30,
    "check_images": true,
    "verify_image_decode": true,
    "max_images": 20000,
    "exclude_patterns": [
      "/wp-admin", "/wp-login.php", "/wp-json", "/feed", "/xmlrpc.php",
      "add-to-cart=", "remove_item=", "undo_item=", "/customer-logout", "action=logout",
      "orderby=", "filter_", "min_price=", "max_price=", "replytocom=", "_wpnonce=",
      "/my-account/", "/checkout/order-received", "/checkout/order-pay"
    ],
    "max_redirect_hops_ok": 1
  },
  "price": {"min": 1, "max": 2000000},
  "brand_residue_patterns": ["NEXUS SELECT", "NEXUS-SELECT", "NEXUSSELECT", "NEXUS　SELECT"],
  "gender_root_slugs": ["mens", "womens", "kids"],
  "category_spec": {
    "enabled": true,
    "expected_counts": {"total": 197, "mens": 149, "womens": 48}
  },
  "invariants": {
    "logo_alt": "AFTER HOURS CLUB",
    "pc_hero_class": "nexus-pc-hero",
    "header_classes": ["nexus-v08-header", "nexus-pc-topbar"],
    "dropdown_class_markers": ["dropdown", "sub-menu", "submenu", "nx-dd"],
    "product_gallery_class": "nexus-gallery"
  },
  "purchase": {
    "enabled": true,
    "browsers": ["webkit", "chromium"],
    "free_shipping_expected": true,
    "tracking_page_path": "",
    "screenshot": true
  }
}
