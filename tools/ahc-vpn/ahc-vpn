#!/usr/bin/env python3
import uuid, argparse, subprocess, time, sys, os, json, pathlib, fcntl
ROOT=pathlib.Path.home()/'.ahc-vpn'; ROOT.mkdir(mode=0o700,exist_ok=True)
SC='/usr/sbin/scutil'
def run(*args):
 return subprocess.run([SC,'--nc',*args],capture_output=True,text=True,timeout=15,check=True).stdout.strip()
def state(name): return run('status',name).splitlines()[0]
def names(): return json.loads((ROOT/'profiles.json').read_text())
def wait(name,target):
 for _ in range(20):
  if state(name)==target:return
  time.sleep(1)
 raise RuntimeError('Connection state timeout: '+name)
def restore(old,new):
 run('stop',new); wait(new,'Disconnected')
 if old: run('start',old); wait(old,'Connected')
def main():
 p=argparse.ArgumentParser(); p.add_argument('action',choices=['list','status','connect','disconnect','confirm','rollback']);p.add_argument('country',nargs='?');p.add_argument('--token');p.add_argument('--lease',type=int,default=60);a=p.parse_args()
 if a.action=='list': print(run('list'));return
 cfg=names(); pending=ROOT/'pending.json'
 with open(ROOT/'lock','a') as lock:
  fcntl.flock(lock,fcntl.LOCK_EX)
  if a.action=='status':
   print(json.dumps({k:state(v) for k,v in cfg.items()}));return
  if a.action=='rollback':
   if pending.exists():
    d=json.loads(pending.read_text());
    if a.token and d['token']!=a.token:return
    restore(d['old'],d['new']);pending.unlink()
   return
  if a.action=='confirm':
   if not pending.exists():raise RuntimeError('No pending switch')
   d=json.loads(pending.read_text())
   if state(d['new'])!='Connected':raise RuntimeError('Not connected')
   pending.unlink();return
  if pending.exists():raise RuntimeError('Pending switch; confirm or rollback first')
  active=[v for v in cfg.values() if state(v)=='Connected']
  if len(active)>1:raise RuntimeError('Multiple active profiles')
  old=active[0] if active else None
  if a.action=='disconnect':
   if old:run('stop',old);wait(old,'Disconnected')
   return
  new=cfg[a.country.upper()] if a.country else None
  if not new:raise RuntimeError('Country required')
  if old==new:return
  if not 30<=a.lease<=300:raise RuntimeError('Lease must be 30–300 seconds')
  token=uuid.uuid4().hex
  pending.write_text(json.dumps({'old':old,'new':new,'token':token}))
  # Independent process survives parent terminal disconnect; not reboot.
  try:
   subprocess.Popen([sys.executable,'-c','import time,subprocess,sys;time.sleep(int(sys.argv[1]));subprocess.run([sys.executable,sys.argv[2],"rollback","--token",sys.argv[3]])',str(a.lease),os.path.abspath(__file__),token],start_new_session=True,stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=open(ROOT/'watchdog.log','a'))
  except Exception:pending.unlink();raise
  try:
   if old:run('stop',old);wait(old,'Disconnected')
   run('start',new);wait(new,'Connected')
  except Exception:
   restore(old,new);pending.unlink();raise
  print('Connected; verify MUSE connectivity and country externally, then confirm before lease expires.')
if __name__=='__main__':
 try:main()
 except Exception as e:print(str(e),file=sys.stderr);sys.exit(1)
